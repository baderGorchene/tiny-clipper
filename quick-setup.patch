+    secretAccessKey: str
+    bucket: str
+
+
+@app.get("/api/setup/status")
+async def setup_status(request: Request):
+    """What the server already has, never the values themselves."""
+    _require_self_host(request)
+    # .env.example ships "your_aws_access_key_here"-style placeholders.
+    has_storage = all((os.environ.get(k) or "your").lower()[:4] != "your"
+                      for k in ("AWS_ACCESS_KEY_ID", "AWS_S3_BUCKET"))
+    return {
+        "geminiOnServer": bool(os.environ.get("GEMINI_API_KEY")),
+        "groqOnServer": bool(os.environ.get("GROQ_API_KEY")),
+        "storage": {
+            "bucket": os.environ.get("AWS_S3_BUCKET") if has_storage else None,
+            "endpoint": os.environ.get("AWS_ENDPOINT_URL") or "",
+        },
+        "retentionHours": JOB_RETENTION_SECONDS // 3600,
+    }
+
+
+@app.post("/api/setup/check-key")
+async def setup_check_key(body: SetupKeyCheck, request: Request):
+    """Ask the provider whether the key works, in words a non-developer gets."""
+    _require_self_host(request)
+    check = SETUP_KEY_CHECKS.get(body.service)
+    key = body.key.strip()
+    if not check or not key:
+        raise HTTPException(status_code=400, detail="Unknown service or empty key")
+    url, header, prefix = check
+    import httpx
+    try:
+        async with httpx.AsyncClient(timeout=15) as client:
+            resp = await client.get(url, headers={header: prefix + key})
+    except httpx.HTTPError:
+        return {"ok": False, "detail": "Couldn't reach the provider. Check your internet connection."}
+    if resp.status_code == 200:
+        return {"ok": True, "detail": "Key works."}
+    if resp.status_code == 429:
+        return {"ok": True, "detail": "Key works, but its free quota is used up for now."}
+    if resp.status_code in (400, 401, 403):
+        return {"ok": False, "detail": "This key was rejected. Copy it again from the provider's page."}
+    return {"ok": False, "detail": f"The provider answered {resp.status_code}. Try again in a minute."}
+
+
+@app.post("/api/setup/storage")
+async def setup_storage(body: SetupStorage, request: Request):
+    """Test the bucket first, then save it to .env so clips are backed up
+    after every job (upload_job_artifacts reads these env vars)."""
+    _require_self_host(request, writes=True)
+    endpoint = body.endpoint.strip().rstrip("/")
+    if endpoint and not endpoint.startswith("https://"):
+        raise HTTPException(status_code=400, detail="The endpoint must start with https://")
+    values = {
+        "AWS_ENDPOINT_URL": endpoint,
+        "AWS_ACCESS_KEY_ID": body.accessKeyId.strip(),
+        "AWS_SECRET_ACCESS_KEY": body.secretAccessKey.strip(),
+        "AWS_S3_BUCKET": body.bucket.strip(),
+        # R2/B2/MinIO take any region; "auto" is what R2 documents.
+        "AWS_REGION": "auto" if endpoint else (os.environ.get("AWS_REGION") or "eu-west-3"),
+    }
+    if not all(values[k] for k in ("AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_S3_BUCKET")):
+        raise HTTPException(status_code=400, detail="Fill in the key ID, the secret and the bucket name")
+
+    def _test_bucket():
+        import boto3
+        boto3.client("s3", endpoint_url=endpoint or None,
+                     aws_access_key_id=values["AWS_ACCESS_KEY_ID"],
+                     aws_secret_access_key=values["AWS_SECRET_ACCESS_KEY"],
+                     region_name=values["AWS_REGION"]).head_bucket(Bucket=values["AWS_S3_BUCKET"])
+
+    try:
+        await asyncio.get_event_loop().run_in_executor(None, _test_bucket)
+    except Exception as e:
+        return {"ok": False, "detail": f"Couldn't open that bucket. Check the values. ({str(e)[:160]})"}
+
+    from dotenv import set_key, unset_key
+    open(STORAGE_ENV_PATH, "a").close()
+    for name, value in values.items():
+        if value:
+            os.environ[name] = value
+            set_key(STORAGE_ENV_PATH, name, value)
+        else:
+            os.environ.pop(name, None)
+            unset_key(STORAGE_ENV_PATH, name)
+    return {"ok": True, "detail": "Connected. Every finished job is now backed up to this bucket."}
