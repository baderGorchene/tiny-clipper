+def groq_retry_wait(retry_after, attempt):
+    """Seconds to wait after a 429: the server's retry-after when it gives one,
+    else exponential backoff; capped at 10 minutes either way."""
+    try:
+        wait = float(retry_after)
+    except (TypeError, ValueError):
+        wait = 15 * 2 ** attempt
+    return max(1.0, min(wait, 600.0))
 
 
