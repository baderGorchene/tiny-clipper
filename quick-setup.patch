+# --- self-host quick setup ---------------------------------------------------
+# Lets the Settings page test a key and save the backup bucket, so nobody has
+# to edit .env by hand. Cloud never exposes these: they touch server config.
+
+SETUP_KEY_CHECKS = {
+    # service: (url that lists models, auth header, header value prefix)
+    "gemini": ("https://generativelanguage.googleapis.com/v1beta/models", "x-goog-api-key", ""),
+    "groq": ("https://api.groq.com/openai/v1/models", "Authorization", "Bearer "),
+}
+STORAGE_ENV_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), ".env")
+
+
+def _require_self_host(request: Request, writes: bool = False):
+    if BILLING_ENABLED:
+        raise HTTPException(status_code=404, detail="Not found")
+    if writes and not setup_client_is_local(
+            request.client.host if request.client else "",
+            request.headers.get("X-Forwarded-For") or ""):
+        raise HTTPException(status_code=403, detail=(
+            "Saving server settings only works from the machine running OpenShorts "
+            "(or your local network). Edit .env on the server instead."))
+
+
+def setup_client_is_local(client_host: str, forwarded_for: str) -> bool:
+    """True when the caller and every proxy hop are loopback/private addresses.
+    ponytail: a public reverse proxy that strips X-Forwarded-For would pass;
+    add a setup password if self-hosts get exposed that way."""
+    import ipaddress
+    hosts = [client_host] + [h.strip() for h in forwarded_for.split(",") if h.strip()]
+    try:
+        return all(ipaddress.ip_address(h).is_private or ipaddress.ip_address(h).is_loopback
+                   for h in hosts)
+    except ValueError:
+        return client_host == "testclient" and not forwarded_for  # FastAPI TestClient
+
+
+class SetupKeyCheck(BaseModel):
