+import React, { useEffect, useState } from 'react';
+import { Check, Eye, EyeOff, ExternalLink, Loader2, ChevronDown, HardDrive } from 'lucide-react';
+import { apiFetch } from '../lib/api';
+
+// Self-host first-run card: the two keys that matter and an optional backup,
+// each with a free-key link and a real test against the provider.
+const KEYS = [
+  {
+    service: 'gemini', title: 'Gemini key', badge: 'Required',
+    what: 'Finds the best moments in your video and writes the titles.',
+    link: 'https://aistudio.google.com/app/apikey', linkLabel: 'Get a free key at Google AI Studio',
+    how: 'Sign in with Google → "Create API key" → copy it here.', placeholder: 'AIza...',
+  },
+  {
+    service: 'groq', title: 'Groq key', badge: 'Recommended',
+    what: 'Turns speech into captions in seconds, for free, without a powerful computer.',
+    link: 'https://console.groq.com/keys', linkLabel: 'Get a free key at Groq',
+    how: 'Sign up → "Create API Key" → copy it here.', placeholder: 'gsk_...',
+  },
+];
+
+const BUCKETS = {
+  r2: { label: 'Cloudflare R2 (10 GB free)', endpoint: 'https://<account-id>.r2.cloudflarestorage.com', link: 'https://dash.cloudflare.com/?to=/:account/r2' },
+  b2: { label: 'Backblaze B2 (10 GB free)', endpoint: 'https://s3.<region>.backblazeb2.com', link: 'https://secure.backblaze.com/b2_buckets.htm' },
+  aws: { label: 'Amazon S3', endpoint: '', link: 'https://s3.console.aws.amazon.com/s3/' },
+  other: { label: 'Other S3-compatible (MinIO…)', endpoint: 'https://', link: null },
+};
+
+function Result({ result }) {
+  if (!result) return null;
+  return (
+    <p role="status" className={`text-xs mt-2 ${result.ok ? 'text-ok' : 'text-warn'}`}>
+      {result.ok ? '✓ ' : '✗ '}{result.detail}
+    </p>
+  );
+}
+
+function KeyStep({ step, n, value, onSave, onServer }) {
+  const [draft, setDraft] = useState(value || '');
+  const [show, setShow] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [result, setResult] = useState(null);
+  const done = !!value || onServer;
+
+  useEffect(() => { setDraft(value || ''); }, [value]);
+
+  const save = async () => {
+    const key = draft.trim();
+    if (!key) return;
+    setBusy(true);
+    setResult(null);
+    try {
+      const res = await apiFetch('/api/setup/check-key', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ service: step.service, key }),
+      });
+      const data = await res.json();
+      setResult(data);
+      if (data.ok) onSave(key);
+    } catch {
+      // Server unreachable: keep the key anyway, the job will tell if it's wrong.
+      onSave(key);
+      setResult({ ok: true, detail: 'Saved (could not test it right now).' });
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <li className="flex gap-3 sm:gap-4">
+      <span className={`w-7 h-7 shrink-0 rounded-full flex items-center justify-center text-xs font-medium ${done ? 'bg-ok text-paper' : 'bg-paper3 text-ink2'}`}>
+        {done ? <Check size={14} /> : n}
+      </span>
+      <div className="flex-1 min-w-0 pb-6">
+        <div className="flex flex-wrap items-center gap-2">
+          <h3 className="text-sm font-medium text-ink">{step.title}</h3>
+          <span className="readout">{step.badge}</span>
+        </div>
+        <p className="text-xs text-muted mt-1">{step.what}</p>
+        {onServer && !value && (
+          <p className="text-xs text-ok mt-1">Already set on the server. You can skip this step.</p>
+        )}
+        <a href={step.link} target="_blank" rel="noopener noreferrer" className="inline-flex items-center gap-1 text-xs text-brass underline mt-2">
+          {step.linkLabel} <ExternalLink size={11} />
+        </a>
+        <p className="text-xs text-muted">{step.how}</p>
+        <form className="flex flex-col sm:flex-row gap-2 mt-3" onSubmit={(e) => { e.preventDefault(); save(); }}>
+          <div className="relative sm:flex-1">
+            <input
+              type={show ? 'text' : 'password'}
+              value={draft}
+              onChange={(e) => { setDraft(e.target.value); setResult(null); }}
+              placeholder={step.placeholder}
+              aria-label={step.title}
+              autoComplete="off"
+              className="input-field pr-10 font-mono"
+            />
+            <button type="button" onClick={() => setShow(!show)} aria-label={show ? 'Hide key' : 'Show key'}
+              className="absolute right-3 top-1/2 -translate-y-1/2 text-muted hover:text-ink">
+              {show ? <EyeOff size={16} /> : <Eye size={16} />}
+            </button>
+          </div>
+          <button type="submit" disabled={!draft.trim() || busy || draft.trim() === value} className="btn-primary py-2 px-4 text-sm">
+            {busy ? <><Loader2 size={14} className="animate-spin" /> Testing…</> : draft.trim() && draft.trim() === value ? <><Check size={14} /> Saved</> : 'Save & test'}
+          </button>
+        </form>
+        <Result result={result} />
+      </div>
+    </li>
+  );
+}
+
+function BackupStep({ n, status, onConnected }) {
+  const connected = !!status?.storage?.bucket;
+  const [open, setOpen] = useState(false);
+  const [kind, setKind] = useState('r2');
+  const [form, setForm] = useState({ endpoint: '', accessKeyId: '', secretAccessKey: '', bucket: '' });
+  const [busy, setBusy] = useState(false);
+  const [result, setResult] = useState(null);
+  const preset = BUCKETS[kind];
+  const field = (name) => ({ value: form[name], onChange: (e) => { setForm({ ...form, [name]: e.target.value }); setResult(null); } });
+
+  const connect = async () => {
+    setBusy(true);
+    setResult(null);
+    try {
+      const res = await apiFetch('/api/setup/storage', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(kind === 'aws' ? { ...form, endpoint: '' } : form),
+      });
+      const data = await res.json();
+      const r = res.ok ? data : { ok: false, detail: data.detail || 'Could not save.' };
+      setResult(r);
+      if (r.ok) onConnected();
+    } catch {
+      setResult({ ok: false, detail: 'Could not reach the OpenShorts server.' });
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <li className="flex gap-3 sm:gap-4">
+      <span className={`w-7 h-7 shrink-0 rounded-full flex items-center justify-center text-xs font-medium ${connected ? 'bg-ok text-paper' : 'bg-paper3 text-ink2'}`}>
+        {connected ? <Check size={14} /> : n}
+      </span>
+      <div className="flex-1 min-w-0">
+        <div className="flex flex-wrap items-center gap-2">
+          <h3 className="text-sm font-medium text-ink">Back up your clips</h3>
+          <span className="readout">Optional</span>
+        </div>
+        <p className="text-xs text-muted mt-1">
+          {connected
+            ? <>Backing up every finished job to <strong className="text-ink2">{status.storage.bucket}</strong>.</>
+            : <>Clips stay on this computer for {status?.retentionHours ?? 24} hours, then they are deleted. Download them, or connect free cloud storage to keep a copy.</>}
+        </p>
+        <button type="button" onClick={() => setOpen(!open)} aria-expanded={open}
+          className="inline-flex items-center gap-1 text-xs text-brass underline mt-2">
+          {connected ? 'Change storage' : 'Connect cloud storage'}
+          <ChevronDown size={12} className={open ? 'rotate-180' : ''} />
+        </button>
+        {open && (
+          <form className="space-y-2 mt-3" onSubmit={(e) => { e.preventDefault(); connect(); }}>
+            <label className="block text-xs text-muted">
+              Storage provider
+              <select className="input-field mt-1" value={kind} onChange={(e) => { setKind(e.target.value); setResult(null); }}>
+                {Object.entries(BUCKETS).map(([k, b]) => <option key={k} value={k}>{b.label}</option>)}
+              </select>
+            </label>
+            {preset.link && (
+              <a href={preset.link} target="_blank" rel="noopener noreferrer" className="inline-flex items-center gap-1 text-xs text-brass underline">
+                Create a bucket and an access key there <ExternalLink size={11} />
+              </a>
+            )}
+            {kind !== 'aws' && (
+              <label className="block text-xs text-muted">
+                Endpoint URL
+                <input className="input-field mt-1 font-mono" placeholder={preset.endpoint} autoComplete="off" {...field('endpoint')} />
+              </label>
+            )}
+            <label className="block text-xs text-muted">
+              Bucket name
+              <input className="input-field mt-1 font-mono" placeholder="my-clips" autoComplete="off" {...field('bucket')} />
+            </label>
+            <div className="grid grid-cols-1 sm:grid-cols-2 gap-2">
+              <label className="block text-xs text-muted">
+                Access key ID
+                <input className="input-field mt-1 font-mono" autoComplete="off" {...field('accessKeyId')} />
+              </label>
+              <label className="block text-xs text-muted">
+                Secret access key
+                <input type="password" className="input-field mt-1 font-mono" autoComplete="off" {...field('secretAccessKey')} />
+              </label>
+            </div>
+            <button type="submit" className="btn-primary py-2 px-4 text-sm"
+              disabled={busy || !form.bucket.trim() || !form.accessKeyId.trim() || !form.secretAccessKey.trim() || (kind !== 'aws' && !form.endpoint.trim())}>
+              {busy ? <><Loader2 size={14} className="animate-spin" /> Testing…</> : <><HardDrive size={14} /> Test & connect</>}
+            </button>
+            <p className="text-xs text-muted">Saved on the OpenShorts server (in its .env file), not in your browser.</p>
+          </form>
+        )}
+        <Result result={result} />
+      </div>
+    </li>
+  );
+}
+
+export default function QuickSetup({ geminiKey, onGeminiKey, groqKey, onGroqKey }) {
+  const [status, setStatus] = useState(null);
+  const load = () => apiFetch('/api/setup/status').then((r) => (r.ok ? r.json() : null)).then(setStatus).catch(() => {});
+  useEffect(() => { load(); }, []);
+
+  const values = { gemini: geminiKey, groq: groqKey };
+  const setters = { gemini: onGeminiKey, groq: onGroqKey };
+  const onServer = { gemini: status?.geminiOnServer, groq: status?.groqOnServer };
+  const doneCount = KEYS.filter((k) => values[k.service] || onServer[k.service]).length + (status?.storage?.bucket ? 1 : 0);
+
+  return (
+    <section className="card p-4 sm:p-6 mb-8 animate-fade" aria-labelledby="quick-setup-title">
+      <div className="flex flex-wrap items-center justify-between gap-2 mb-1">
+        <h2 id="quick-setup-title" className="font-display lowercase text-lg text-ink">Quick setup</h2>
+        <span className={doneCount >= 1 && (geminiKey || status?.geminiOnServer) ? 'badge-ok' : 'readout'}>
+          {doneCount} of 3 done
+        </span>
+      </div>
+      <p className="text-xs text-muted mb-6">
+        Three steps, all free. Only the first one is needed to start making clips.
+        Keys stay in this browser and go to your OpenShorts server only while a job runs.
+      </p>
+      <ol>
+        {KEYS.map((step, i) => (
+          <KeyStep key={step.service} step={step} n={i + 1} value={values[step.service]}
+            onSave={setters[step.service]} onServer={!!onServer[step.service]} />
+        ))}
+        <BackupStep n={3} status={status} onConnected={load} />
+      </ol>
+    </section>
+  );
+}
